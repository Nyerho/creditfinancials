rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == '8NrNmNRS5XddTyfAdBCF2GFBz3x2'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // The admin marker itself can be read by its owner so the client can
    // determine whether to start the full admin synchronization. Only an
    // existing admin can create, update, or delete admin markers.
    match /admins/{adminId} {
      allow read: if signedIn() && (adminId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Administrators need complete read/write access to every application
    // collection so the admin portal behaves identically on every device.
    // Firestore rules are evaluated as OR across matching paths.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // A signed-in customer may access only their own profile and records.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /accounts/{accountId} {
      allow read, write: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read, write: if signedIn()
        && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds;
    }

    match /cards/{cardId} {
      allow read, write: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /loans/{loanId} {
      allow read, write: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read, write: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /payees/{payeeId} {
      allow read, write: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /auditLog/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /login_otps/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /mail/{messageId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
